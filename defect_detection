        "# Identify manufacturing process and give recommendations\n",
        "\n",
        "def identify_process(defect_count, critical, major, minor):\n",
        "    print(\"=== MANUFACTURING PROCESS ANALYSIS ===\")\n",
        "\n",
        "    # Identify likely process based on defect pattern\n",
        "    if critical > 2:\n",
        "        process = \"Sand Casting / Die Casting\"\n",
        "        defect_type = \"Porosity / Blowholes detected\"\n",
        "    elif major > 3:\n",
        "        process = \"Welding / Forging\"\n",
        "        defect_type = \"Surface cracks / Inclusions detected\"\n",
        "    elif minor > 5:\n",
        "        process = \"Machining / Sheet Metal\"\n",
        "        defect_type = \"Tool marks / Surface finish issues detected\"\n",
        "    else:\n",
        "        process = \"Machined Component\"\n",
        "        defect_type = \"Minor surface irregularities\"\n",
        "\n",
        "    print(f\"Likely Process  : {process}\")\n",
        "    print(f\"Defect Type     : {defect_type}\")\n",
        "    print()\n",
        "\n",
        "    # Dimensional analysis\n",
        "    print(\"=== DIMENSIONAL ANALYSIS ===\")\n",
        "    total_defect_area = sum(cv2.contourArea(c) for c in contours if cv2.contourArea(c) > 20)\n",
        "    image_area = image.shape[0] * image.shape[1]\n",
        "    defect_percentage = (total_defect_area / image_area) * 100\n",
        "\n",
        "    print(f\"Defect Area     : {defect_percentage:.2f}% of surface\")\n",
        "\n",
        "    if defect_percentage > 10:\n",
        "        print(\"Dimensional     : OUT OF TOLERANCE\")\n",
        "    elif defect_percentage > 5:\n",
        "        print(\"Dimensional     : BORDERLINE\")\n",
        "    else:\n",
        "        print(\"Dimensional     : WITHIN TOLERANCE\")\n",
        "    print()\n",
        "\n",
        "    # Recommendations\n",
        "    print(\"=== RECOMMENDATIONS ===\")\n",
        "\n",
        "    if critical > 0:\n",
        "        print(\"→ Reject part immediately\")\n",
        "        print(\"→ Check mold/die condition\")\n",
        "        print(\"→ Review pouring temperature\")\n",
        "        print(\"→ Inspect raw material quality\")\n",
        "    elif major > 0:\n",
        "        print(\"→ Send for rework\")\n",
        "        print(\"→ Check machine parameters\")\n",
        "        print(\"→ Review operator technique\")\n",
        "        print(\"→ Increase inspection frequency\")\n",
        "    else:\n",
        "        print(\"→ Part acceptable for use\")\n",
        "        print(\"→ Monitor surface finish process\")\n",
        "        print(\"→ Routine maintenance check\")\n",
        "        print(\"→ Document for quality records\")\n",
        "\n",
        "# Run the analysis\n",
        "identify_process(defect_count, critical, major, minor)"
